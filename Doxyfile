PROJECT_NAME           = "AWK Minifier"
PROJECT_BRIEF          = "Conservative AWK source minification"
OUTPUT_DIRECTORY       = doc/reference
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
INPUT                  = src doc/adr/README.md doc/adr
FILE_PATTERNS          = *.awk *.md
RECURSIVE              = YES
EXCLUDE                = doc/adr/README.intro.md doc/adr/README.outro.md doc/adr/templates
FILTER_PATTERNS        = *.awk=vendor/doxygen-awk.awk
EXTENSION_MAPPING      = awk=C
USE_MDFILE_AS_MAINPAGE = doc/adr/README.md
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = YES
